# Leave blank to use deterministic local matching only.
ANTHROPIC_API_KEY=

# Fast, economical model suitable for ranking a high volume of jobs.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Optional locally. Hosted deployment enables this and requires APP_PASSWORD.
REFERRALS_AUTH_REQUIRED=false
APP_USERNAME=referrals
APP_PASSWORD=

# Optional local defaults.
DATABASE_URL=sqlite:///./referrals.db
MATCHING_TIMEOUT_SECONDS=45
SCAN_INTERVAL_SECONDS=21600
WORKER_POLL_SECONDS=5
SCAN_STALE_AFTER_SECONDS=3600
